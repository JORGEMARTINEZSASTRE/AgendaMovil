# Copiar a .env y completar con los valores reales.
# El .env NUNCA se commitea: tiene credenciales.
# En produccion estos valores viven en el panel de Railway.

# ── Base de datos ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ── Sesiones ───────────────────────────────────────
# Cadena larga y aleatoria. Si se cambia, todas las
# operadoras tienen que volver a loguearse.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ── Servidor ───────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://127.0.0.1:5500

# ── Admin inicial (seed-admin) ─────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=

# ── Mail (SMTP) ────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=

# ── Cloudinary (fotos de servicios y logos) ────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
